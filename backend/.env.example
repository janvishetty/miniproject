# Copy this file to backend/.env and fill in the values.
#   macOS/Linux : cp .env.example .env
#   PowerShell  : Copy-Item .env.example .env
# backend/.env is git-ignored. NEVER commit it and NEVER put these values in the frontend.

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=PASTE_YOUR_PROJECT_URL_HERE
# SECRET. Server-side only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE
# Public-style key. Used only for the password sign-in call.
SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE

# development | production | test   (production turns /docs and /redoc off)
APP_ENV=development

# Comma-separated list of exact frontend origins. "*" is rejected on purpose.
CORS_ORIGINS=http://localhost:5173

# true = new accounts are confirmed immediately (development).
# Set to false in production if you want Supabase to send confirmation emails.
AUTO_CONFIRM_EMAIL=true

# Used by later steps (optional now; defaults point at the repo folders).
# DATA_DIR=../data
# ML_OUTPUT_DIR=./ml/output
# ML_PYTHON must be an ABSOLUTE path to a Python executable (a bare name like python3 is refused).
# ML_PYTHON=/absolute/path/to/repo/.venv/bin/python3
# Seconds allowed per pipeline script (default 600, allowed 10-3600).
# ML_STEP_TIMEOUT_SECONDS=
